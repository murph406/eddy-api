{
  "name": "eddy-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "docs:build": "rm -rf docs/dist && mkdir -p docs/dist && cp docs/index.html openapi/openapi.yaml docs/dist/",
    "docs:preview": "npm run docs:build && npx serve docs/dist",
    "lint:fix": "eslint src/ --fix",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "start": "nodemon --watch src --ext js,ts,json --exec 'npm run typecheck && node scripts/env-to-json.js && sam build && sam local start-api -p 8000 --host 0.0.0.0'"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1150.0",
    "@aws-sdk/client-s3": "^3.1150.0",
    "axios": "^1.20.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}